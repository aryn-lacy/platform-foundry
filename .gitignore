# terraform state — never committed
**.tfstate*
crash.log

# terraform working dirs (lock file IS committed: dependency pinning is part of reproducibility)
.terraform/

# tfvars — except the per-environment inputs, which are intentionally public
*.tfvars
!infra/envs/*.tfvars

# plan artifacts
tfplan
*.tfplan

# build artifacts
apps/backend/build/
apps/frontend/node_modules/
apps/frontend/build/
apps/frontend/dist/

# tooling
.env
.env.*
*.log
.DS_Store
vendor/

# node
npm-debug.log*
.yarn/
